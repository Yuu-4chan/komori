{
  "name": "komori",
  "version": "1.0.2",
  "private": true,
  "author": "Yuu-4chan",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "node scripts/tauri.mjs",
    "tauri:build": "node scripts/tauri.mjs build --config src-tauri/tauri.release.conf.json",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:release": "node scripts/tauri.mjs build --config src-tauri/tauri.release.conf.json --config src-tauri/tauri.updater.conf.json && node scripts/release-manifest.mjs",
    "build": "node scripts/reader-fonts.mjs && tsc -b && vite build && node scripts/third-party-notices.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:reader-real": "node scripts/reader-real/run.mjs",
    "validate:task": "node scripts/validate.mjs task",
    "validate:full": "node scripts/validate.mjs full",
    "validate:release": "node scripts/validate.mjs release"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.0.0",
    "epubjs": "^0.3.93",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.50.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
